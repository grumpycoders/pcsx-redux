TARGET = mdecplayer
TYPE = ps-exe

# Point this at a blob from packstream.py. No default on purpose: a player built
# with no stream should fail, not run with nothing to show.
STREAM ?=

ifeq ($(STREAM),)

# CI walks every directory under examples/ and runs a bare `make all`, so an
# unset STREAM has to be a no-op rather than an error. The frames are a video
# you bring, and there is nothing sensible to default to.
all dep:
	@echo 'mdecplayer: set STREAM to a blob built by packstream.py to build this, e.g.'
	@echo '            make STREAM=/tmp/ntsc.bin'

clean:
	rm -f stream-gen.s stream-gen.dep stream-gen.o .stream-*

.PHONY: all dep clean

else

SRCS = \
mdecplayer.cpp \
stream-gen.s \
../../../bsdec/bsdec.c \
../../../common/crt0/clz.c \

CPPFLAGS += -I../../..
CXXFLAGS = -std=c++20

# The two alternate build modes, as switches rather than as advice: overriding
# CXXFLAGS on the command line drops the -fno-rtti/-fno-exceptions the psyqo
# build adds with +=, and the failure is a link error about __gxx_personality_v0
# that says nothing about the real cause.
#   make STREAM=... CAPTURE=0   decode frame 0, hand it back over pcdrv, exit
#   make STREAM=... PROFILE=1   print where each frame's time goes
CAPTURE ?=
PROFILE ?=
ifneq ($(CAPTURE),)
CPPFLAGS += -DMDECPLAYER_CAPTURE=$(CAPTURE)
endif
ifneq ($(PROFILE),)
CPPFLAGS += -DMDECPLAYER_PROFILE
endif

include ../../psyqo.mk

# THE PROBLEM: make decides on MTIMES, and STREAM is a parameter it cannot see.
# Three shapes failed before this one, each shipping byte-identical NTSC and PAL
# binaries with no error - the wrong video is indistinguishable from the right one.
#   - .incbin a fixed symlink: make follows it to the BLOB's mtime, so pointing at
#     an older blob leaves a newer object looking current.
#   - the same, with the recipe deleting the object: the recipe never runs, because
#     the symlink itself is up to date.
#   - a .PHONY prerequisite: re-runs during the dep pass and under -j deletes the
#     object after the link.
# THE FIX: put the parameters in a FILENAME. The tag's name is a hash of them, so
# changing any one names a tag that does not exist, whose recipe wipes what that
# parameter feeds. mtimes then tell the truth.
# CAPTURE and PROFILE are in the hash for the same reason STREAM is: they are
# invisible to make, and mdecplayer.o is what they change, so the recipe has to
# wipe that too or a mode switch silently reuses the other mode's object.
STREAMTAG := .stream-$(shell printf '%s' '$(abspath $(STREAM))|$(CAPTURE)|$(PROFILE)' | md5sum | cut -c1-12)

$(STREAMTAG):
	rm -f .stream-* stream-gen.s stream-gen.o stream-gen.dep mdecplayer.o mdecplayer.dep
	touch $@

mdecplayer.o: $(STREAMTAG)

stream-gen.s: $(STREAM) Makefile $(STREAMTAG)
	@printf '/* GENERATED by the Makefile from STREAM. Do not edit, do not commit. */\n' > $@
	@printf '    .section .rodata\n    .align 4\n    .globl g_stream\ng_stream:\n' >> $@
	@printf '    .incbin "%s"\n    .align 4\n' '$(abspath $(STREAM))' >> $@

clean::
	rm -f stream-gen.s stream-gen.dep stream-gen.o .stream-*

# A build that embedded the wrong video is otherwise indistinguishable from a
# correct one, so check it rather than trust the dependency graph.
check-stream: $(BINDIR)$(TARGET).$(TYPE)
	@code=$$(($$(stat -c %s $(BINDIR)$(TARGET).$(TYPE)) - $$(stat -c %s $(STREAM)))); \
	if [ $$code -lt 0 ] || [ $$code -gt 262144 ]; then \
	    echo "mdecplayer: $(BINDIR)$(TARGET).$(TYPE) does not embed $(STREAM)"; \
	    echo "            binary minus stream is $$code bytes, expected a small code size"; \
	    exit 1; \
	fi; \
	echo "mdecplayer: $(STREAM) embedded, $$code bytes of code around it"

endif
